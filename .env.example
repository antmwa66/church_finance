# Copy this file to ".env" and fill in real values for production.
# NEVER commit your real .env (it contains secrets).

# Required in production. Generate a strong random key, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave unset for local SQLite, or set a Postgres URL in production:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/church_finance
# DATABASE_URL=sqlite:///church_finance.db

# Set to "true" only for local debugging. Always "false" in production.
FLASK_DEBUG=false

# Port the app listens on (used by gunicorn/Procfile).
PORT=5000

# Optional: email sending for password resets.
# Leave MAIL_SERVER empty to disable email (reset links are shown on screen instead).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@church.org
